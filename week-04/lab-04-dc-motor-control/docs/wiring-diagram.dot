digraph motor {
  graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.6", ranksep="1.05", fontname="DejaVu Sans", label="Lab 4 — Arduino Uno + L293D motor driver (logical wiring)", labelloc=t, fontsize=19, fontcolor="#172b4d"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fa", color="#3d647d", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.13"];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.7, color="#596f86"];
  uno [label="{Arduino Uno|D9 PWM|D7 direction 1|D8 direction 2|GND}"];
  supply [label="{Power MB V2|5V regulated output|GND}", fillcolor="#eef8ed", color="#3c8157"];
  driver [label="{L293D H-bridge|pin 1 EN|pin 2 IN1|pin 7 IN2|pin 16 VCC1|pin 8 VCC2|pins 4,5,12,13 GND|pin 3 OUT1|pin 6 OUT2}", fillcolor="#fff4df", color="#ac8135"];
  motor [label="{3–6V DC motor|red lead|black lead}", fillcolor="#fce9e9", color="#aa6666"];
  uno -> driver [label="D9 → EN (C5)\nD7 → IN1 (C6)\nD8 → IN2 (C11)", color="#416b9a", penwidth=1.7];
  supply -> driver [label="5V → VCC1 (H5)\n5V → VCC2 (A12)", color="#308251", penwidth=1.7];
  supply -> uno [label="GND ↔ common GND\nvia A9 / D8", color="#555555", dir=none, constraint=false, minlen=2];
  supply -> driver [label="GND → all four ground pins", color="#555555", constraint=false];
  driver -> motor [label="OUT1 (A7) → red\nOUT2 (A10) → black", color="#b65f45", penwidth=1.7];
}
